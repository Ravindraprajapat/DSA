class Solution {
    public int findMaxLength(int[] nums) {
        int n = nums.length;
        HashMap<Integer,Integer> map = new HashMap<>();
        int max = -1;
        map.put(0,-1);
        int currSum =  0;
        for(int i=0;i<n;i++){
            int num = nums[i];
            if(num ==0){
                currSum = currSum-1;
                if(map.containsKey(currSum)){
                    max = Math.max(max,i-map.get(currSum));
                }
                else map.put(currSum,i);
                
            }
            if(num==1){
                currSum = currSum+1;
                if(map.containsKey(currSum)){
                    max = Math.max(max,i-map.get(currSum));
                }
                else map.put(currSum,i);
            }
        }  
        return max==-1 ? 0 : max;     
    }
}