class Solution {
    public boolean checkTree(TreeNode root) {
        if(root == null) return false;
        int val = 0;
        if( root.left!=null && root.right!=null){
            val =  root.left.val+root.right.val;
        }
        if(root.val == val){
            return true;
        }
        return false;
    }
}
