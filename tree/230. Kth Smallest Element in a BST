


class Solution {
    int count =0 , res =0;
     void Inorder(TreeNode root, int k){
        if(root==null) return ;
        Inorder(root.left,k);
        count++;
        if(count==k){
          res = root.val;
          return;
        }
        Inorder(root.right,k);
        
    }
    public int kthSmallest(TreeNode root, int k) {
     Inorder(root,k);
    return res;    
    }
}


class Solution {
    List<Integer> num = new ArrayList<>();
     void Inorder(TreeNode root, int n){
        if(root==null) return;
        Inorder(root.left,0);
        if(root!=null){
            num.add(root.val);
        }
        Inorder(root.right,0);
    }
    public int kthSmallest(TreeNode root, int k) {
        Inorder(root,0);
        Collections.sort(num);
        return num.get(k-1);
    }
}
