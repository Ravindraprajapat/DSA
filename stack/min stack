class MinStack {
   Stack<Long> st = new Stack<>();
   long min = -1;
    public MinStack() {
        
    }
    
    public void push(int val) {
        long v =(long)val;
        if(st.size()==0){
            st.push(v);
            min=v;
        }
        else if(v>=min){
            st.push(v);
        }
        else if(v<min){
            st.push(2*v-min);
            min=v;
        }
    }
    
    public void pop() {
        if(st.size()==0) return;
        if(st.peek()>=min){
            st.pop();
        }
        else{
            long newOld = 2*min - st.peek();
            min=newOld;
            st.pop();
        }
    }
    
    public int top() {
        if(st.size()==0) return -1;
        long n = st.peek();
        if(n >=min) return (int)n;
        else return (int)min;
    }
    
    public int getMin() {
        if(st.size()==0) return -1;
        return (int)min;
    }
}

