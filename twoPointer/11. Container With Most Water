class Solution {
    public int maxArea(int[] height) {
        int n = height.length;
        int maxArea=0;
        int i=0,j=n-1;
        while(i<j){
            int heigt = Math.min(height[i],height[j]);
            int width = j-i;
            maxArea = Math.max(maxArea, heigt*width);
            if(height[i]<height[j]){
                i++;
            }
            else{
                j--;
            }
        }
        return maxArea;
    }
}
