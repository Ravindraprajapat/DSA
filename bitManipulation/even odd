class Solution {
    public int[] countOddEven(int[] arr) {
       int n = arr.length;
       int o = 0;
       int e = 0;
       for(int i=0;i<n;i++){
           if((arr[i]&1) == 0){
               e++;
           }
           else{
               o++;
           }
       }
       return new int[]{o,e};
    }
}