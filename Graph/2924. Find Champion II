class Solution {
    public int findChampion(int n, int[][] edges) {
      int indegree[] = new int[n];
        for(int i = 0; i < edges.length; i++) {
            int v = edges[i][1];
            indegree[v]++;
        }
        int camp = -1;
        for(int i = 0; i < n; i++) {
            if(indegree[i] == 0) {
                if(camp != -1) {
                    return -1;
                }
                camp = i;
            }
        }
        return camp;
    }
}



