class Solution {

    public class Triplet {
        int row;
        int col;
        int time;

        public Triplet(int row, int col, int time) {
            this.row = row;
            this.col = col;
            this.time = time;
        }
    }

    public int orangesRotting(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        Queue<Triplet> q = new LinkedList<>();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 2) {
                    q.add(new Triplet(i, j, 0));
                }
            }
        }

        int maxTime = 0;
        while (q.size() > 0) {
            Triplet fr = q.remove();
            int row = fr.row;
            int col = fr.col;
            int time = fr.time;
            maxTime = Math.max(maxTime, time);
            if (col - 1 >= 0 && mat[row][col - 1] == 1) { // go left
                mat[row][col - 1] = 2;
                q.add(new Triplet(row, col - 1, time + 1));
            }

            if (col + 1 < n && mat[row][col + 1] == 1) { // go right
                mat[row][col + 1] = 2;
                q.add(new Triplet(row, col + 1, time + 1));
            }

            if (row - 1 >= 0 && mat[row - 1][col] == 1) { // go up 
                mat[row - 1][col] = 2;
                q.add(new Triplet(row - 1, col, time + 1));
            }

            if (row + 1 < m && mat[row + 1][col] == 1) { // gp down
                mat[row + 1][col] = 2;
                q.add(new Triplet(row + 1, col, time + 1));
            }
        }

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 1) {
                    return -1;
                }
            }
        }
        return maxTime;
    }
}