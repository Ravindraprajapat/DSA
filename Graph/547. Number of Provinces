class Solution {
     void bfs(int i , int[][] isConnected , boolean[] isvisited){
        int n = isConnected.length;
        Queue<Integer> que = new LinkedList<>();
        que.add(i);
        while(que.size() > 0){
            int front = que.remove();
            for (int j = 0; j < n; j++) {
                if(isConnected[front][j]==1 && isvisited[j]==false){
                    que.add(j);
                    isvisited[j] = true;
                }
            }
        }
    }

    public int findCircleNum(int[][] isConnected) {
       int n = isConnected.length;
       boolean isvisted[] = new boolean[n];
       int count = 0;
        for (int i = 0; i < n; i++) {
            if(!isvisted[i]){
                bfs(i,isConnected,isvisted);
                count++;
            }
        }
        return  count;
    }
}