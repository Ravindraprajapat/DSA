class Solution {

    class Pair implements Comparable<Pair> {
        int node;
        double dis;

        public Pair(int node, double dis) {
            this.node = node;
            this.dis = dis;
        }

        public int compareTo(Pair p) {

            return Double.compare(p.dis,this.dis);
        }
    }

    public double maxProbability(int n, int[][] edges, double[] succProb, int src, int end) {
        double[] ans = new double[n];
        List<List<Pair>> adj = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<Pair>());
        }
        for (int i = 0; i < edges.length; i++) {
            int u = edges[i][0];
            int v = edges[i][1];
            double dis = succProb[i];
            adj.get(u).add(new Pair(v, dis));
            adj.get(v).add(new Pair(u, dis));
        }
        Arrays.fill(ans,0.0);
        ans[src] = 1;
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        pq.add(new Pair(src, 1.0));
        while (pq.size() > 0) {
            Pair top = pq.remove();
            int node = top.node;
            double dis = top.dis;
            if (dis < ans[node])
                continue;
            for (Pair p : adj.get(node)) {
                double TotalDis = p.dis * dis;
                if (TotalDis > ans[p.node]) {
                    ans[p.node] = TotalDis;
                    pq.add(new Pair(p.node, TotalDis));
                }
            }
        }

        if (ans[end] == Double.MAX_VALUE) {
            return (double) 0;
        }
        return ans[end];
    }
}