class Solution {

    boolean bfs(int src, int color[], int[][] graph) {
        Queue<Integer> q = new LinkedList<>();
        q.add(src);
        color[src] = 1;
        while (q.size() > 0) {
            int vertex = q.remove();
            int col = color[vertex];
            for (int i = 0; i < graph[vertex].length; i++) {
                int ele = graph[vertex][i];
                if (color[ele] == 0) {
                    q.add(ele);
                    color[ele] = 3 - col;
                } else if (color[ele] == col) {
                    return false;
                }
            }

        }
        return true;
    }

    public boolean isBipartite(int[][] graph) {
        int n = graph.length;
        int color[] = new int[n];
        for (int i = 0; i < n; i++) {
            if (color[i] == 0) {
                if (!bfs(i, color, graph)) {
                    return false;
                }
            }
        }
        return true;
    }
}