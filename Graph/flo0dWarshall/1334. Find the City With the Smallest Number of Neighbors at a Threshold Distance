class Solution {
    // algo
      public int findTheCity(int n, int[][] edges, int distanceThreshold) {
       int[][] dist = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                dist[i][j] = Integer.MAX_VALUE;
            }
        }

        for (int[] arr : edges){
            int u = arr[0];
            int v = arr[1];
            int w = arr[2];
            dist[u][v] = w;
            dist[v][u] = w; 
        }

        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                if (i==k) continue;
                for (int j = 0; j < n; j++) {
                    if (j==k) continue;
                    if (dist[i][k]!=Integer.MAX_VALUE && dist[k][j]!=Integer.MAX_VALUE) {
                    dist[i][j] = Math.min(dist[i][j], dist[i][k] + dist[k][j]);
                }
                }
            }
        }
        int city  = -1;
        int minCount  = Integer.MAX_VALUE;
        for (int i = 0; i < n; i++) {
            int count =0;
            for (int j = 0; j < n; j++) {
                if (i==j) continue;
                if(dist[i][j] <= distanceThreshold) count++;
            }
            if(count <= minCount){
                city = i;
                minCount = count;
            }
        }
        return city;
    }
}