class Solution {
    class pair {
        int row;
        int col;

        public pair(int row, int col) {
            this.row = row;
            this.col = col;
        }
    }

    public int numEnclaves(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        Queue<pair> q = new LinkedList<>();
        for (int i = 0; i < n; i++) {
            if (mat[0][i] == 1) {
                mat[0][i] = -1;
                q.add(new pair(0, i));
            }

            if (mat[m - 1][i] == 1) {
                mat[m - 1][i] = -1;
                q.add(new pair(m - 1, i));
            }
        }
        for (int i = 0; i < m; i++) {
            if (mat[i][0] == 1) {
                mat[i][0] = -1;
                q.add(new pair(i, 0));
            }

            if (mat[i][n - 1] == 1) {
                mat[i][n - 1] = -1;
                q.add(new pair(i, n - 1));
            }
        }
        while (q.size() > 0) {
            pair fr = q.remove();
            int row = fr.row;
            int col = fr.col;
            // go up 
            if (row-1 >= 0 && mat[row - 1][col] == 1) {
                mat[row - 1][col] = -1;
                q.add(new pair(row - 1, col));
            }
            // go down
            // go up 
            if (row+1 < m && mat[row + 1][col] == 1) {
                mat[row + 1][col] = -1;
                q.add(new pair(row + 1, col));
            }
            // go left
            if (col-1 >= 0 && mat[row][col - 1] == 1) {
                mat[row][col - 1] = -1;
                q.add(new pair(row, col - 1));
            }
            // go right
            if (col+1 < n && mat[row][col + 1] == 1) {
                mat[row][col + 1] = -1;
                q.add(new pair(row, col + 1));
            }
        }
        int count = 0;
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 1) {
                    count++;
                }
            }
        }
        return count;
    }
}