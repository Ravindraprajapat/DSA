class Solution {
    
    void dfs(int node ,boolean vis[],  ArrayList<Integer> ans,ArrayList<ArrayList<Integer>> adj ){
        vis[node] = true;
        ans.add(node);
        for(int ele : adj.get(node)){
            if(!vis[ele]){
            dfs(ele,vis,ans,adj);
            }
        }
    }
    
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
       int n = adj.size();
       boolean vis[] = new boolean[n];
        ArrayList<Integer> ans = new ArrayList<>();
        for(int i=0;i<n;i++){
            if(!vis[i]){
                dfs(i,vis,ans,adj);
            }
        }
        return ans;
    }
}