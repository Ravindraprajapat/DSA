
public class Solution {
    public ListNode detectCycle(ListNode head) {

        if(head==null || head.next==null){
            return null;
        }

         ListNode temp=head;
        Set<ListNode> set = new HashSet<>();
        ListNode p = null;
        while(temp!=null){
            if(!set.contains(temp)){
                set.add(temp);
            }
            else{
                p=temp;
                break;
            }
            temp=temp.next;
        }
        
        if(p==null){
            return null;
        }
        return p;
