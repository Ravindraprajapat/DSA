
class Solution {
    public ListNode swapPairs(ListNode head) {
      int k = 2;
      int count = 0;
      ListNode temp = head;
      while(count<k){
        if(temp == null) return head;
        temp=temp.next;
        count++;
      }
      count=0;
      ListNode prev =null;
      ListNode next =null;
      ListNode curr = head;
      while(curr!=null && count<k){
        next = curr.next;
        curr.next = prev;
        prev=curr;
        curr=next;
        count++;
      }
      if(next!=null){
        head.next= swapPairs(next);
      }
      return prev;
    }
}
