class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
       ListNode dummy = new ListNode(0);
       ListNode ans = dummy;
       int sum=0;
       int carry=0;
       while(l1!=null || l2!=null || carry!=0){
        if(l1!=null){
            sum+=l1.val;
            l1=l1.next;
        }

        if(l2!=null){
            sum+=l2.val;
            l2=l2.next;
        }

        int num = sum%10;
        carry = sum/10;
        
        ans.next = new ListNode(num);
        ans= ans.next;
        sum=carry;
       }
       return dummy.next;
    }
}





