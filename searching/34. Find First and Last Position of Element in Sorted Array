class Solution {

    int lowerBound(int[] nums , int target,int n){
       int res = n;
       int low=0;
       int high=n-1;
       while(low<=high){
        int mid = low+(high-low)/2;
        if(nums[mid]>=target){
            high=mid-1;
            res=mid;
        }
        else{
            low=mid+1;
        }
       }
       return res;
    }
    
     int upperBound(int[] nums , int target,int n){
       int res = n;
       int low=0;
       int high=n-1;
       while(low<=high){
        int mid = low+(high-low)/2;
        if(nums[mid]>target){
            high=mid-1;
            res=mid;
        }
        else{
            low=mid+1;
        }
       }
       return res;
    }
    
    public int[] searchRange(int[] nums, int target) {
        int n = nums.length;
        int pos1=lowerBound(nums,target,n);
        int pos2=upperBound(nums,target,n);
        if( pos1==n || nums[pos1]!=target){
             return new int[]{-1,-1};
        }
        return new int[]{pos1,pos2-1};
    }
}
