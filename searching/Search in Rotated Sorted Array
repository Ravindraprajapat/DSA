class Solution {

     int searchele(int[] nums , int target , int n){
        int low=0;
        int high=n-1;
        while(low<=high){
            int mid = low+(high-low)/2;
            if(nums[mid]==target) return mid;
            if(nums[low]<=nums[mid]){
                if(nums[low]<=target && target<=nums[mid]){
                    high=mid-1;
                }
                else{
                    low=mid+1;
                }
            }
            else{
                 if(nums[mid]<=target && target<=nums[high] ){
                    low=mid+1;
                }
                else{
                    high=mid-1;
                }
            }
        }
        return -1;
     }

    public int search(int[] nums, int target) {
        return searchele(nums,target,nums.length);
    }
}
