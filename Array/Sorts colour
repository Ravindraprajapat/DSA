class Solution {
    void swap(int[] nums , int st , int ed){
        int temp = nums[st];
        nums[st]=nums[ed];
        nums[ed]=temp;
    }
    public void sortColors(int[] nums) {
         int mid=0;
         int start=0;
         int end = nums.length-1;
         while(mid<=end){
         if(nums[mid]==0){
            swap(nums,start,mid);
            start++;
            mid++;
         }
         else if(nums[mid]==1){
            mid++;
         }
         else{
            swap(nums,mid,end);
            end--;
         }
         }
    }
}
