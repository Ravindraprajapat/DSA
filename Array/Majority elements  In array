majority-| 
class Solution {
    public int majorityElement(int[] nums) {
        int n = nums.length;
        int count =1;
        int maj = nums[0];
        for(int i=1;i<n;i++){
            if(count==0){
                maj=nums[i];
            }
            if(nums[i]==maj){
                count++;
            }
            else{
                count--;
            }
        }
        return maj;
    }
}


2. majority element-|| in array
class Solution {
    public List<Integer> majorityElement(int[] nums) {
         int n  = nums.length;
         int count1=0;
         int count2=0;
         Integer maj1=null,maj2=null;
          List<Integer> list = new ArrayList<>();
         for(int i=0;i<n;i++){
            if(maj1!=null && nums[i]==maj1){
                count1++;
            }
            else if(maj2!=null && nums[i]==maj2){
                count2++;
            }
            else if(count1==0){
                maj1=nums[i];
                count1=1;
            }
            else if(count2==0){
                 maj2=nums[i];
                 count2=1;
            }
            else{
             count1--;
             count2--;   
            }
         }

         int freq1=0;
         int freq2=0;
         for(int num : nums){
            if(num==maj1){
                freq1++;
            }
            else if(num==maj2){
                freq2++;
            }
         }
         if(maj1!=null && freq1>n/3) list.add(maj1);
         if(maj2!=null && freq2>n/3) list.add(maj2);
         Collections.sort(list);
         return list;
    }
}
