class Solution {
    int dp[];

    int loot(int nums[], int i, int n) {
        if (i > n)
            return 0;
        if (dp[i] != -1)
            return dp[i];

        int pick = nums[i] + loot(nums, i + 2, n);
        int skip = loot(nums, i + 1, n);
        int ans = Math.max(skip, pick);
        return dp[i] = ans;
    }

    public int rob(int[] nums) {
        int n = nums.length;
        if(n==1) return nums[0];
        dp = new int[n];
        Arrays.fill(dp, -1);
        int first = loot(nums, 0, n - 2);
        Arrays.fill(dp, -1);
        int second = loot(nums, 1, n - 1);
        return Math.max(first, second);
    }
}