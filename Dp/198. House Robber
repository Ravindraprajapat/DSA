class Solution {
     int dp[];
     public int loot(int[] nums,int i){
        if(i>=nums.length) return 0;
        if(dp[i]!=-1) return dp[i];
        int pick = nums[i] +  loot(nums,i+2);
        int skip = loot(nums,i+1);
        int ans = Math.max(pick , skip);
        dp[i] = ans;
        return ans;
     }
    public int rob(int[] nums) {
        dp = new int[nums.length];
        Arrays.fill(dp,-1);
        return loot(nums,0);
    }
}