class Solution {
    int Paths(int m , int n , int[][] dp){
        if(m==1 || n==1) return 1;
        if(dp[m][n]!=0) return dp[m][n];
        return dp[m][n] = Paths(m-1,n,dp)+Paths(m,n-1,dp);
    }
    public int uniquePaths(int m, int n) {
        int[][] dp =new int[m+1][n+1];
        return Paths(m,n,dp);
    }
}