class Solution {
    public int totalFruit(int[] fruits) {
        
        int n = fruits.length;
        int i=0,j=0;
        HashMap<Integer,Integer> map = new HashMap<>();
        int max = -1;
        while(j<n){
            map.put(fruits[j],map.getOrDefault(fruits[j],0)+1);
            if(map.size()<=2){
                max=Math.max(max,j-i+1);
            }
            else{
                map.put(fruits[i],map.get(fruits[i])-1);
              if(map.get(fruits[i])==0){
                map.remove(fruits[i]);
              }
              i++;
            }
          j++;
        }
        return max;
    }
}
