public class maxSum {
   public static int  SumMax(int[] arr,int k){
        int n = arr.length;
        int sum=0;

        for (int i = 0; i < k; i++) {
            sum+=arr[i];
        }
        int maxSumIs =sum;
        for (int i = k; i <n; i++) {
           sum =sum+arr[i]-arr[i-k];
           maxSumIs = Math.max(sum,maxSumIs);
        }
        return  maxSumIs;
    }
    public static void main(String[] args) {
        int[] arr = {100,200,300,400};
        int k = 2;
        int value = SumMax(arr,k);
        System.out.println(value);
    }
}
