class Solution {
     
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode dummyNode = new ListNode(0);
        dummyNode.next=head;
       ListNode fast = dummyNode;
       ListNode slow = dummyNode;
       for(int i=0;i<n;i++){
        fast=fast.next;
       }
       while(fast.next!=null){
        slow=slow.next;
        fast=fast.next;
       }
       slow.next = slow.next.next;
       return dummyNode.next;
    }
}

